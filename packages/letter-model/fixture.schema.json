{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/your-own-font/your-own-font/packages/letter-model/fixture.schema.json",
  "title": "Recorded handwriting session (letter model fixture)",
  "description": "One file per session, written by tools/collect/index.html. Format: docs/letter-model.md §5. Structural rules the schema cannot express (indices in range, splits chained in point order, letterOfStroke of a split stroke = letter of its last piece, every letter owns ink) are checked by checkWord in packages/pipeline/src/letter-model/fixture.ts.",
  "type": "object",
  "required": ["version", "writerId", "device", "pointerType", "recordedAt", "words"],
  "properties": {
    "version": { "const": 1 },
    "writerId": { "type": "string", "minLength": 1 },
    "device": { "type": "string", "minLength": 1 },
    "pointerType": { "enum": ["touch", "pen", "mouse", "synthetic"] },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "consent": { "type": "string", "description": "The consent line shown to the writer, verbatim." },
    "words": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/word" } }
  },
  "$defs": {
    "split": {
      "type": "object",
      "required": ["stroke", "atPoint", "left", "right"],
      "properties": {
        "stroke": { "type": "integer", "minimum": 0 },
        "atPoint": { "type": "integer", "minimum": 1, "description": "Index of the cut point; it belongs to both pieces." },
        "left": { "type": "integer", "minimum": 0 },
        "right": { "type": "integer", "minimum": 0 },
        "range": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2, "description": "Synthetic words only: first and last point of the run-on connector." }
      }
    },
    "word": {
      "type": "object",
      "required": ["text", "guides", "strokes", "letterOfStroke", "splits"],
      "properties": {
        "text": { "type": "string", "pattern": "^[a-z,.'!?]+$" },
        "guides": {
          "type": "object",
          "required": ["baseline", "xHeight"],
          "properties": { "baseline": { "type": "number" }, "xHeight": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "strokes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["points"],
            "properties": {
              "points": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x, y, pressure, tMs] in pad pixels, y down" }
              }
            }
          }
        },
        "letterOfStroke": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "splits": { "type": "array", "items": { "$ref": "#/$defs/split" } },
        "proposal": {
          "type": "object",
          "description": "What the segmenter proposed before the labeller's fixes (tools/collect).",
          "required": ["mode", "letterOfStroke", "splits"],
          "properties": {
            "mode": { "enum": ["model", "geometry"] },
            "letterOfStroke": { "type": "array", "items": { "type": "integer" } },
            "splits": { "type": "array", "items": { "$ref": "#/$defs/split" } }
          }
        },
        "meta": { "type": "object" }
      }
    }
  }
}
